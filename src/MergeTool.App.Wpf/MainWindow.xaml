<Window x:Class="MergeTool.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MergeTool.App.Wpf.ViewModels"
        xmlns:views="clr-namespace:MergeTool.App.Wpf.Views"
        xmlns:controls="clr-namespace:MergeTool.App.Wpf.Controls"
        Title="MergeTool" Height="700" Width="1240" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToCollapsed" />

        <DataTemplate DataType="{x:Type vm:FileCompareWorkspaceViewModel}">
            <views:FileCompareView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FolderCompareWorkspaceViewModel}">
            <views:FolderCompareView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ThreeWayFolderCompareWorkspaceViewModel}">
            <views:ThreeWayFolderCompareView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ThreeWayCompareWorkspaceViewModel}">
            <views:ThreeWayCompareView />
        </DataTemplate>

        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9B9B9F" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style x:Key="RibbonGroupSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="#FF4A4A4E" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
        <Style x:Key="StatusSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="4,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Ribbon: quick actions. Contextual buttons bind to the active workspace and are
             disabled automatically when the workspace lacks the command. -->
        <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE8A5;" Label="File Compare"
                                Command="{Binding NewFileCompareCommand}"
                                ToolTip="Open a new file comparison tab"
                                AutomationProperties.Name="File Compare" />
                            <controls:RibbonQuickActionButton Glyph="&#xE8B7;" Label="Folder Compare"
                                Command="{Binding ShowFolderCompareCommand}"
                                ToolTip="Open the folder comparison tab"
                                AutomationProperties.Name="Folder Compare" />
                            <controls:RibbonQuickActionButton Glyph="&#xE8A5;" Label="3-Way Files"
                                Command="{Binding ShowThreeWayCompareCommand}"
                                ToolTip="Open the three-way file comparison tab"
                                AutomationProperties.Name="Three-way compare" />
                            <controls:RibbonQuickActionButton Glyph="&#xE8B7;" Label="3-Way Folders"
                                Command="{Binding ShowThreeWayFolderCompareCommand}"
                                ToolTip="Open the three-way folder comparison tab"
                                AutomationProperties.Name="Three-way folder compare" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="New" />
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE768;" Label="Compare"
                                Command="{Binding ActiveWorkspace.CompareCommand}"
                                ToolTip="Run the comparison for the active tab"
                                AutomationProperties.Name="Compare" />
                            <controls:RibbonQuickActionButton Glyph="&#xE72C;" Label="Recompare"
                                Command="{Binding ActiveWorkspace.RecompareCommand}"
                                ToolTip="Recompare (F5)"
                                AutomationProperties.Name="Recompare" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Compare" />
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE892;" Label="Previous"
                                Command="{Binding ActiveWorkspace.PreviousDifferenceCommand}"
                                ToolTip="Previous difference (Shift+F7)"
                                AutomationProperties.Name="Previous difference" />
                            <controls:RibbonQuickActionButton Glyph="&#xE893;" Label="Next"
                                Command="{Binding ActiveWorkspace.NextDifferenceCommand}"
                                ToolTip="Next difference (F7)"
                                AutomationProperties.Name="Next difference" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Navigate" />
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE72B;" Label="Copy to Left"
                                Command="{Binding ActiveWorkspace.CopyToLeftCommand}"
                                ToolTip="Copy the selected difference into the left document"
                                AutomationProperties.Name="Copy current change to left" />
                            <controls:RibbonQuickActionButton Glyph="&#xE72A;" Label="Copy to Right"
                                Command="{Binding ActiveWorkspace.CopyToRightCommand}"
                                ToolTip="Copy the selected difference into the right document"
                                AutomationProperties.Name="Copy current change to right" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Merge" />
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE74E;" Label="Save Left"
                                Command="{Binding ActiveWorkspace.SaveLeftCommand}"
                                ToolTip="Save the left document"
                                AutomationProperties.Name="Save left file" />
                            <controls:RibbonQuickActionButton Glyph="&#xE74E;" Label="Save Right"
                                Command="{Binding ActiveWorkspace.SaveRightCommand}"
                                ToolTip="Save the right document"
                                AutomationProperties.Name="Save right file" />
                            <controls:RibbonQuickActionButton Glyph="&#xEA35;" Label="Save All"
                                Command="{Binding ActiveWorkspace.SaveAllCommand}"
                                ToolTip="Save all modified documents (Ctrl+Shift+S)"
                                AutomationProperties.Name="Save all files" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="Save" />
                    </StackPanel>

                    <Rectangle Style="{StaticResource RibbonGroupSeparator}" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonQuickActionButton Glyph="&#xE740;" Label="Expand All"
                                Command="{Binding ActiveWorkspace.ExpandAllCollapsedCommand}"
                                ToolTip="Expand all collapsed unchanged sections"
                                AutomationProperties.Name="Expand all collapsed regions" />
                            <controls:RibbonQuickActionButton Glyph="&#xE721;" Label="Find"
                                Command="{Binding ActiveWorkspace.ShowFindPanelCommand}"
                                ToolTip="Open the find panel (Ctrl+F)"
                                AutomationProperties.Name="Find" />
                            <controls:RibbonQuickActionButton Glyph="&#xE713;" Label="Options"
                                Command="{Binding ActiveWorkspace.ShowComparisonSettingsCommand}"
                                ToolTip="Comparison settings: whitespace, case, ignore rules, profiles"
                                AutomationProperties.Name="Comparison settings" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RibbonGroupLabel}" Text="View" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Sessions: recents and pinned, collapsed by default to keep chrome minimal. -->
        <Border DockPanel.Dock="Top" Background="#FF3A3A3D" Padding="10,2">
            <StackPanel>
                <Expander Foreground="#FFDDDDDD" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock Text="Sessions (recent and pinned comparisons)" Foreground="#FFDDDDDD" />
                    </Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                        <TextBlock Text="Recents:" Foreground="#FFDDDDDD" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Recents}"
                                  SelectedItem="{Binding SelectedRecent, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayLabel"
                                  Width="260" Margin="0,0,8,0"
                                  AutomationProperties.Name="Recent comparisons" />
                        <Button Content="Open" Command="{Binding OpenRecentCommand}" Padding="10,3" Margin="0,0,16,0"
                                AutomationProperties.Name="Open recent comparison" />
                        <TextBlock Text="Pinned:" Foreground="#FFDDDDDD" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Pinned}"
                                  SelectedItem="{Binding SelectedPinned, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayLabel"
                                  Width="260" Margin="0,0,8,0"
                                  AutomationProperties.Name="Pinned comparisons" />
                        <Button Content="Open" Command="{Binding OpenPinnedCommand}" Padding="10,3" Margin="0,0,16,0"
                                AutomationProperties.Name="Open pinned comparison" />
                        <Button Content="Pin active" Command="{Binding PinActiveSessionCommand}" Padding="10,3" Margin="0,0,8,0"
                                AutomationProperties.Name="Pin active comparison" />
                        <Button Content="Clear recents" Command="{Binding ClearRecentsCommand}" Padding="10,3" Margin="0,0,8,0"
                                AutomationProperties.Name="Clear recent comparisons" />
                        <Button Content="Reset settings" Command="{Binding ResetSettingsCommand}" Padding="10,3"
                                AutomationProperties.Name="Reset application settings" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding SettingsStatusText}" Foreground="#FFFFD580"
                           TextWrapping="Wrap"
                           Visibility="{Binding SettingsStatusText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>

        <!-- Status bar: workspace state, progress, difference position, stale flag, encodings. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveWorkspace.State, FallbackValue=Idle}" />
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding ActiveWorkspace.IsBusy, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="12" Margin="8,0" />
                    <TextBlock Text="{Binding ActiveWorkspace.BusyText}" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding ActiveWorkspace.CancelCommand}"
                            Padding="10,0" AutomationProperties.Name="Cancel operation" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="STALE — recompare (F5)" Foreground="#FFB05A00" FontWeight="SemiBold"
                           Visibility="{Binding ActiveWorkspace.IsComparisonStale, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveWorkspace.NavigationText, FallbackValue=''}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ActiveWorkspace.LeftPane.EncodingDisplay, FallbackValue=''}"
                               Foreground="#FF777777" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding ActiveWorkspace.RightPane.EncodingDisplay, FallbackValue=''}"
                               Foreground="#FF777777" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Workspace tabs -->
        <TabControl ItemsSource="{Binding Workspaces}"
                    SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <Button Content="✕" Margin="8,0,0,0" Padding="4,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding DataContext.CloseWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Close workspace" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </DockPanel>
</Window>
