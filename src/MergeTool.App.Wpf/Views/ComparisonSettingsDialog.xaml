<Window x:Class="MergeTool.App.Wpf.Views.ComparisonSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comparison settings"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AutomationProperties.Name="Comparison settings dialog">
    <StackPanel Margin="14">
        <TextBlock Text="Comparison rules" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />
        <TextBlock Text="Rule changes apply after the next Compare or Recompare (F5)."
                   Foreground="#FF777777" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Whitespace" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding WhitespaceModes}"
                      SelectedItem="{Binding WhitespaceMode}"
                      Margin="0,0,12,8" MinWidth="140"
                      AutomationProperties.Name="Whitespace comparison mode" />
            <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                      Content="Ignore case" IsChecked="{Binding IgnoreCase}" Margin="0,0,0,8"
                      VerticalAlignment="Center" />

            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="Ignore empty lines" IsChecked="{Binding IgnoreEmptyLines}" Margin="0,0,12,8" />
            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                      Content="Detect moved blocks" IsChecked="{Binding DetectMovedBlocks}" Margin="0,0,0,8"
                      ToolTip="Mark deleted/inserted regions with identical text as moved (bounded scan)." />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ignored line" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                     Text="{Binding IgnoredLinePattern, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" Padding="4"
                     ToolTip="Regular expression; matching lines are excluded from comparison."
                     AutomationProperties.Name="Ignored line pattern" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ignored block" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding IgnoredBlockStartPattern, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,6,8" Padding="4"
                     ToolTip="Start marker regular expression."
                     AutomationProperties.Name="Ignored block start pattern" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="to" VerticalAlignment="Center" Margin="0,0,6,8" />
            <TextBox Grid.Row="3" Grid.Column="3"
                     Text="{Binding IgnoredBlockEndPattern, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4" Margin="0,0,0,8"
                     ToolTip="End marker regular expression."
                     AutomationProperties.Name="Ignored block end pattern" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Structured view" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                      ItemsSource="{Binding StructuredFormatOptions}"
                      SelectedValue="{Binding StructuredFormat, Mode=TwoWay}"
                      SelectedValuePath="Kind"
                      DisplayMemberPath="DisplayName"
                      Margin="0,0,0,8"
                      ToolTip="Pretty-print JSON or XML for comparison display only. Merge requires Raw mode."
                      AutomationProperties.Name="Structured view format" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="File profile" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="5" Grid.Column="1"
                      ItemsSource="{Binding AvailableProfiles}"
                      SelectedValue="{Binding ProfileOverride, Mode=TwoWay}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="DisplayName"
                      MinWidth="140" Margin="0,0,12,0"
                      AutomationProperties.Name="File type profile" />
            <TextBlock Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2"
                       Text="{Binding ProfileBadge}" VerticalAlignment="Center"
                       Foreground="#FF1A6FB5" FontWeight="SemiBold" />
        </Grid>

        <Separator Margin="0,12,0,8" />
        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Padding="0,4"
                    IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="Close comparison settings" />
            <TextBlock Text="{Binding ActiveRulesBadge}" VerticalAlignment="Center"
                       Foreground="#FF1A6FB5" FontSize="11" />
        </DockPanel>
    </StackPanel>
</Window>
