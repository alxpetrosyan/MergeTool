<UserControl x:Class="MergeTool.App.Wpf.Views.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MergeTool.App.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Diagnostics}"
                  Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="#FFFFF4E5" BorderBrush="#FFE0C48C" BorderThickness="1"
                        Padding="8" Margin="0,0,0,4" CornerRadius="3">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Copy details"
                                    Command="{Binding CopyDetailsCommand}"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    ToolTip="Copy diagnostic code, message, and technical details to the clipboard." />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Code}" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#FF777777" Margin="0,4,0,0"
                                   Visibility="{Binding Path, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding RecoveryHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="#FF1A6FB5" FontStyle="Italic"
                                   Visibility="{Binding HasRecoveryHint, Converter={StaticResource BoolToVisibility}}" />
                        <Expander Header="Technical details" Margin="0,4,0,0"
                                  Visibility="{Binding HasTechnicalDetail, Converter={StaticResource BoolToVisibility}}"
                                  IsExpanded="{Binding ShowTechnicalDetail, Mode=TwoWay}">
                            <TextBlock Text="{Binding VisibleTechnicalDetail}" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" />
                        </Expander>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
