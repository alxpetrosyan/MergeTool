<UserControl x:Class="MergeTool.App.Wpf.Views.FolderCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MergeTool.App.Wpf.Views"
             xmlns:controls="clr-namespace:MergeTool.App.Wpf.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToCollapsed" />

        <Style x:Key="FolderRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="LeftOnly">
                    <Setter Property="Background" Value="#FFFFE8E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="RightOnly">
                    <Setter Property="Background" Value="#FFE8F4FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="MetadataDifferent">
                    <Setter Property="Background" Value="#FFFFF3D6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Background" Value="#FFFFE0E0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="SkippedReparsePoint">
                    <Setter Property="Background" Value="#FFF0E8FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ContentDifferent">
                    <Setter Property="Background" Value="#FFFFE8CC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFB00020" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style x:Key="ExpanderCellButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Path selector row (reusable editable combos) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:PathComboSelector Grid.Column="0" Margin="0,0,6,0"
                                        LabelText="Left folder"
                                        Text="{Binding LeftRoot}"
                                        Kind="Folder"
                                        RecentPaths="{Binding RecentPaths}"
                                        BrowseCommand="{Binding ChooseLeftFolderCommand}"
                                        AutomationName="Left folder path"
                                        BrowseAutomationName="Choose left folder"
                                        DropDownAutomationName="Left folder suggestions" />
            <controls:PathComboSelector Grid.Column="1" Margin="6,0,0,0"
                                        LabelText="Right folder"
                                        Text="{Binding RightRoot}"
                                        Kind="Folder"
                                        RecentPaths="{Binding RecentPaths}"
                                        BrowseCommand="{Binding ChooseRightFolderCommand}"
                                        AutomationName="Right folder path"
                                        BrowseAutomationName="Choose right folder"
                                        DropDownAutomationName="Right folder suggestions" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF555555" />
            <ComboBox ItemsSource="{Binding ComparisonModes}"
                      SelectedItem="{Binding ComparisonMode}"
                      Width="150" Padding="4,2"
                      AutomationProperties.Name="Folder comparison mode" />
            <TextBlock Text="Timestamp tolerance (seconds):"
                       VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#FF555555"
                       IsEnabled="{Binding IsTimestampToleranceEnabled}" />
            <TextBox Text="{Binding TimestampToleranceSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="48" Padding="4"
                     IsEnabled="{Binding IsTimestampToleranceEnabled}"
                     AutomationProperties.Name="Metadata timestamp tolerance seconds" />
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#FFB00020"
                   Text="{Binding RootValidationMessage}"
                   Visibility="{Binding RootValidationMessage, Converter={StaticResource NullToCollapsed}}" />

        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#FF555555" />
            <Button Content="All" Command="{Binding SetFilterAllCommand}" Padding="10,3" Margin="0,0,6,4" />
            <Button Content="Differences" Command="{Binding SetFilterDifferencesCommand}" Padding="10,3" Margin="0,0,6,4" />
            <Button Content="Left only" Command="{Binding SetFilterLeftOnlyCommand}" Padding="10,3" Margin="0,0,6,4"
                    AutomationProperties.Name="Filter left only" />
            <Button Content="Right only" Command="{Binding SetFilterRightOnlyCommand}" Padding="10,3" Margin="0,0,6,4"
                    AutomationProperties.Name="Filter right only" />
            <Button Content="Errors/Skipped" Command="{Binding SetFilterErrorsSkippedCommand}" Padding="10,3" Margin="0,0,12,4" />
            <TextBlock Text="{Binding ActiveFilter}" VerticalAlignment="Center" Foreground="#FF777777" Margin="0,0,12,4" />
            <Button Content="Expand all" Command="{Binding ExpandAllFoldersCommand}" Padding="10,3" Margin="0,0,6,4"
                    AutomationProperties.Name="Expand all folders" />
            <Button Content="Collapse all" Command="{Binding CollapseAllFoldersCommand}" Padding="10,3" Margin="0,0,12,4"
                    AutomationProperties.Name="Collapse all folders" />
            <Button Content="Open paired text comparison"
                    Command="{Binding OpenPairedTextComparisonCommand}" Padding="10,3" Margin="0,0,0,4"
                    AutomationProperties.Name="Open paired text comparison" />
            <Button Content="Copy L → R"
                    Command="{Binding CopyLeftToRightCommand}" Padding="10,3" Margin="12,0,6,4"
                    AutomationProperties.Name="Copy left to right" />
            <Button Content="Copy R → L"
                    Command="{Binding CopyRightToLeftCommand}" Padding="10,3" Margin="0,0,12,4"
                    AutomationProperties.Name="Copy right to left" />
            <Separator Width="12" Margin="0,0,12,4" />
            <Button Content="Delete left"
                    Command="{Binding DeleteLeftCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,4"
                    ToolTip="Delete selected left-only files (confirmation required)."
                    AutomationProperties.Name="Delete left file" />
            <Button Content="Delete right"
                    Command="{Binding DeleteRightCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,4"
                    ToolTip="Delete selected right-only files (confirmation required)."
                    AutomationProperties.Name="Delete right file" />
            <Button Content="Find rename candidates"
                    Command="{Binding FindRenameCandidatesCommand}" Padding="10,3" Margin="0,0,0,4"
                    ToolTip="Suggest rename pairings between left-only and right-only files. Does not rename or copy anything."
                    AutomationProperties.Name="Find rename candidates" />
        </WrapPanel>

        <TextBlock Grid.Row="4" Margin="0,6,0,4" Foreground="#FF555555"
                   Text="{Binding ScanStatusText}"
                   Visibility="{Binding ScanStatusText, Converter={StaticResource NullToCollapsed}}" />

        <views:DiagnosticsPanel Grid.Row="5" Margin="0,4,0,0" />

        <!-- Folder comparison tree-grid: expandable directories with aligned left/right data -->
        <DataGrid Grid.Row="6"
                  x:Name="FolderRowsGrid"
                  ItemsSource="{Binding TreeRows}"
                  SelectionMode="Extended"
                  SelectionChanged="FolderRows_SelectionChanged"
                  MouseDoubleClick="FolderRows_MouseDoubleClick"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  RowStyle="{StaticResource FolderRowStyle}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AutomationProperties.Name="Folder comparison results">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open file comparison" Command="{Binding OpenPairedTextComparisonCommand}" />
                    <MenuItem Header="Copy left to right" Command="{Binding CopyLeftToRightCommand}" />
                    <MenuItem Header="Copy right to left" Command="{Binding CopyRightToLeftCommand}" />
                    <Separator />
                    <MenuItem Header="Reveal left in Explorer" Command="{Binding RevealLeftInExplorerCommand}" />
                    <MenuItem Header="Reveal right in Explorer" Command="{Binding RevealRightInExplorerCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="RelativePath">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                <Button Style="{StaticResource ExpanderCellButton}"
                                        Content="{Binding ExpanderGlyph}"
                                        Command="{Binding ToggleExpandCommand}"
                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="2,0,0,0"
                                           ToolTip="{Binding RelativePath}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="0.6*" />
                <DataGridTextColumn Header="Left size" Binding="{Binding LeftSizeDisplay}" Width="0.7*" />
                <DataGridTextColumn Header="Left modified (UTC)" Binding="{Binding LeftTimeDisplay}" Width="1.1*" />
                <DataGridTextColumn Header="Right size" Binding="{Binding RightSizeDisplay}" Width="0.7*" />
                <DataGridTextColumn Header="Right modified (UTC)" Binding="{Binding RightTimeDisplay}" Width="1.1*" />
                <DataGridTextColumn Header="Diagnostics" Binding="{Binding DiagnosticsDisplay}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="7" Margin="0,8,0,0" Padding="8" BorderBrush="#FFCCCCCC" BorderThickness="1"
                Visibility="{Binding RenameCandidatesStatusText, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Compare files" Command="{Binding AcceptRenameCandidateCommand}" Padding="10,3"
                            AutomationProperties.Name="Compare rename candidate files" />
                    <Button Content="Clear" Command="{Binding ClearRenameCandidatesCommand}" Padding="10,3" Margin="6,0,0,0"
                            AutomationProperties.Name="Clear rename candidates" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Rename candidates (suggestions only)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RenameCandidatesStatusText}" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding RenameCandidates}"
                             SelectedItem="{Binding SelectedRenameCandidate, Mode=TwoWay}"
                             DisplayMemberPath="DisplayText"
                             MaxHeight="120"
                             AutomationProperties.Name="Rename candidate suggestions" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Expander Grid.Row="8" Margin="0,6,0,0" Header="Legend and state colors" IsExpanded="True">
            <Border Padding="8" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding MetadataLegendText}" TextWrapping="Wrap" Foreground="#FF555555" />
                    <TextBlock Text="{Binding ContentLegendText}"
                               TextWrapping="Wrap" Foreground="#FF555555" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Width="14" Height="14" Background="#FFFFE8E8" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock Text="Left only" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" Background="#FFE8F4FF" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock Text="Right only" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" Background="#FFFFF3D6" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock Text="Metadata different" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" Background="#FFFFE0E0" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock Text="Error" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Width="14" Height="14" Background="#FFF0E8FF" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                        <TextBlock Text="Skipped reparse point" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
