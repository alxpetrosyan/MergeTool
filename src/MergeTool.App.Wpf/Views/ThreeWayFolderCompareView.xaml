<UserControl x:Class="MergeTool.App.Wpf.Views.ThreeWayFolderCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MergeTool.App.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToVisibilityConverter x:Key="NullToCollapsed" />

        <Style x:Key="FolderRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="BaseOnly">
                    <Setter Property="Background" Value="#FFF5F0E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LeftOnly">
                    <Setter Property="Background" Value="#FFFFE8E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="RightOnly">
                    <Setter Property="Background" Value="#FFE8F4FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="BaseLeftOnly">
                    <Setter Property="Background" Value="#FFFFF0E0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="BaseRightOnly">
                    <Setter Property="Background" Value="#FFE8F0FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LeftRightOnly">
                    <Setter Property="Background" Value="#FFFFE8F8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="MetadataDifferent">
                    <Setter Property="Background" Value="#FFFFF3D6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="MetadataMatch">
                    <Setter Property="Background" Value="#FFEEF6EE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Background" Value="#FFFFE0E0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="SkippedReparsePoint">
                    <Setter Property="Background" Value="#FFF0E8FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ContentMatch">
                    <Setter Property="Background" Value="#FFE0F0E8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ContentDifferent">
                    <Setter Property="Background" Value="#FFFFE8CC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Base folder" Margin="0,0,0,2" Foreground="#FF555555" />
                <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0"
                        Command="{Binding ChooseBaseFolderCommand}"
                        AutomationProperties.Name="Choose base folder" />
                <TextBox Text="{Binding BaseRoot, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Base folder path" Padding="4" />
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Left folder" Margin="0,0,0,2" Foreground="#FF555555" />
                <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0"
                        Command="{Binding ChooseLeftFolderCommand}"
                        AutomationProperties.Name="Choose left folder" />
                <TextBox Text="{Binding LeftRoot, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Left folder path" Padding="4" />
            </DockPanel>
            <DockPanel Grid.Column="2" Margin="6,0,6,0">
                <TextBlock DockPanel.Dock="Top" Text="Right folder" Margin="0,0,0,2" Foreground="#FF555555" />
                <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0"
                        Command="{Binding ChooseRightFolderCommand}"
                        AutomationProperties.Name="Choose right folder" />
                <TextBox Text="{Binding RightRoot, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Right folder path" Padding="4" />
            </DockPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Compare" Command="{Binding CompareCommand}" Padding="16,4" />
                <Button Content="Recompare" Command="{Binding RecompareCommand}" Padding="16,4" Margin="6,0,0,0"
                        AutomationProperties.Name="Recompare folders" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
            <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF555555" />
            <ComboBox ItemsSource="{Binding ComparisonModes}"
                      SelectedItem="{Binding ComparisonMode}"
                      Width="150" Padding="4,2"
                      AutomationProperties.Name="Folder comparison mode" />
            <TextBlock Text="Timestamp tolerance (seconds):"
                       VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#FF555555"
                       IsEnabled="{Binding IsTimestampToleranceEnabled}" />
            <TextBox Text="{Binding TimestampToleranceSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="48" Padding="4"
                     IsEnabled="{Binding IsTimestampToleranceEnabled}"
                     AutomationProperties.Name="Metadata timestamp tolerance seconds" />
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#FFB00020"
                   Text="{Binding RootValidationMessage}"
                   Visibility="{Binding RootValidationMessage, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Grid.Row="3" Margin="0,8,0,0" Orientation="Horizontal">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF555555" />
            <Button Content="All" Command="{Binding SetFilterAllCommand}" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="Differences" Command="{Binding SetFilterDifferencesCommand}" Padding="10,3" Margin="0,0,6,0" />
            <Button Content="Errors/Skipped" Command="{Binding SetFilterErrorsSkippedCommand}" Padding="10,3" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ActiveFilter}" VerticalAlignment="Center" Foreground="#FF777777" Margin="0,0,12,0" />
            <Button Content="Open 3-way text comparison"
                    Command="{Binding OpenThreeWayTextComparisonCommand}" Padding="10,3"
                    AutomationProperties.Name="Open three-way text comparison" />
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,6,0,4" Foreground="#FF555555"
                   Text="{Binding ScanStatusText}"
                   Visibility="{Binding ScanStatusText, Converter={StaticResource NullToCollapsed}}" />

        <views:DiagnosticsPanel Grid.Row="5" Margin="0,4,0,0" />

        <DataGrid Grid.Row="6"
                  x:Name="FolderRowsGrid"
                  ItemsSource="{Binding FilteredRows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionChanged="FolderRows_SelectionChanged"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  RowStyle="{StaticResource FolderRowStyle}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AutomationProperties.Name="Three-way folder comparison results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="2*" />
                <DataGridTextColumn Header="State" Binding="{Binding StateDisplay}" Width="*" />
                <DataGridTextColumn Header="Base size" Binding="{Binding BaseSizeDisplay}" Width="*" />
                <DataGridTextColumn Header="Base modified (UTC)" Binding="{Binding BaseTimeDisplay}" Width="1.2*" />
                <DataGridTextColumn Header="Left size" Binding="{Binding LeftSizeDisplay}" Width="*" />
                <DataGridTextColumn Header="Left modified (UTC)" Binding="{Binding LeftTimeDisplay}" Width="1.2*" />
                <DataGridTextColumn Header="Right size" Binding="{Binding RightSizeDisplay}" Width="*" />
                <DataGridTextColumn Header="Right modified (UTC)" Binding="{Binding RightTimeDisplay}" Width="1.2*" />
                <DataGridTextColumn Header="Diagnostics" Binding="{Binding DiagnosticsDisplay}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="7" Margin="0,8,0,0" Padding="8" Background="#FFF5F5F5" BorderBrush="#FFDDDDDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Quick comparison legend" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding MetadataLegendText}" TextWrapping="Wrap" Foreground="#FF555555" />
                <TextBlock Text="{Binding ContentLegendText}"
                           TextWrapping="Wrap" Foreground="#FF555555" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Width="14" Height="14" Background="#FFF5F0E8" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                    <TextBlock Text="Base only" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Border Width="14" Height="14" Background="#FFFFE8E8" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                    <TextBlock Text="Left only" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Border Width="14" Height="14" Background="#FFE8F4FF" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                    <TextBlock Text="Right only" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Border Width="14" Height="14" Background="#FFFFF3D6" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                    <TextBlock Text="Metadata different" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Border Width="14" Height="14" Background="#FFEEF6EE" BorderBrush="#FFCCCCCC" BorderThickness="1" Margin="0,0,4,0" />
                    <TextBlock Text="Metadata match" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
